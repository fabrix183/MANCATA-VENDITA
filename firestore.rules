rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Collezione "voci": le mancate vendite.
    // Solo chi ha effettuato l'accesso (anche in forma anonima,
    // che avviene in automatico all'apertura del sito) può leggere
    // e scrivere. Un visitatore anonimo di internet che NON apre
    // il sito non ottiene mai una sessione e quindi non può
    // leggere/scrivere via API dirette.
    match /voci/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['stato', 'createdAt'])
        && request.resource.data.stato == 'attiva';

      allow update: if request.auth != null;

      allow delete: if request.auth != null
        && resource.data.stato == 'archiviata';
    }

    // Blocca tutto il resto per default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
